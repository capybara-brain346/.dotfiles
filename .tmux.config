unbind r
bind r source-file ~/.tmux.conf

set -g prefix C-s
set -g mouse off

set-option -sg escape-time 10

set -g base-index 1
setw -g pane-base-index 1

set-option -g status-position top

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'catppuccin/tmux#v2.1.2'
set -g default-terminal "tmux-256color"

# ==============================
# Catppuccin Theme Configuration
# ==============================

# Flavor: macchiato | latte | frappe | mocha
set -g @catppuccin_flavor "macchiato"

# Transparent background (set to "none" for true transparency support)
set -g @catppuccin_status_background "none"

# Window status style: "rounded" | "none" | "custom"
set -g @catppuccin_window_status_style "rounded"

# Enable pane status indicators
set -g @catppuccin_pane_status_enabled "on"

# Pane border status: "off" | "message"
set -g @catppuccin_pane_border_status "off"

# Directory truncation length
set -g @catppuccin_directory_trunc_len "3"

# ── Status modules ─────────────────────────────────────────────
# Left side: session icon + name
set -g status-left-length 100
set -g status-left ""
set -ga status-left "#{?client_prefix,"
set -ga status-left "#[bg=#{@thm_red},fg=#{@thm_bg},bold]  #S "
set -ga status-left ","
set -ga status-left "#[bg=#{@thm_surface_0},fg=#{@thm_green}]  #S "
set -ga status-left "}"
set -ga status-left "#[bg=#{@thm_surface_0},fg=#{@thm_overlay_0}]█"

# Center: window list
set -g status-justify absolute-centre

# Right side: date/time and host
set -g status-right-length 120
set -g status-right ""
set -ga status-right "#[bg=#{@thm_surface_0},fg=#{@thm_overlay_0}]█"
set -ga status-right "#[bg=#{@thm_surface_0},fg=#{@thm_mauve}] 󰍹 #H "
set -ga status-right "#[bg=#{@thm_surface_0},fg=#{@thm_overlay_0}]█"
set -ga status-right "#[bg=#{@thm_surface_0},fg=#{@thm_sky}] 󱄠 #{pane_current_command} "
set -ga status-right "#[bg=#{@thm_surface_0},fg=#{@thm_overlay_0}]█"
set -ga status-right "#[bg=#{@thm_surface_0},fg=#{@thm_yellow}] 󰍳 #{?session_created, #{strftime %R,#{session_created}},} "
set -ga status-right "#[bg=#{@thm_surface_0},fg=#{@thm_overlay_0}]█"
set -ga status-right "#[bg=#{@thm_surface_0},fg=#{@thm_blue}] 󰃭 %Y-%m-%d 󰥔 %H:%M "
set -ga status-right "#[bg=default,fg=#{@thm_surface_0}]█"

# ── Window list styling ────────────────────────────────────────
set -g window-status-separator "#[bg=#{@thm_surface_0},fg=#{@thm_overlay_0}]█"

set -wg automatic-rename on
set -g automatic-rename-format "Window"

# Inactive / non-current windows
set -g window-status-format " #{?window_last_flag,󰖱 ,}#I#{?#{!=:#{window_name},Window},: #W,} "
set -g window-status-style "bg=#{@thm_surface_0},fg=#{@thm_subtext_0}"

# Last active window
set -g window-status-last-style "bg=#{@thm_surface_0},fg=#{@thm_peach}"

# Window with activity
set -g window-status-activity-style "bg=#{@thm_surface_0},fg=#{@thm_red}"

# Window with bell
set -g window-status-bell-style "bg=#{@thm_red},fg=#{@thm_bg},bold"

# Current (active) window
set -g window-status-current-format "#[bg=#{@thm_peach},fg=#{@thm_bg},bold] 󰮯 #I#{?#{!=:#{window_name},Window},: #W,} "
set -g window-status-current-style "bg=#{@thm_surface_0},fg=#{@thm_peach}"

# ── Pane border styling ────────────────────────────────────────
setw -g pane-border-status top
setw -g pane-border-format "#[fg=#{@thm_overlay_0}] #{pane_index} #{pane_current_command} "
setw -g pane-active-border-style "bg=#{@thm_bg},fg=#{@thm_mauve}"
setw -g pane-border-style "bg=#{@thm_bg},fg=#{@thm_surface_0}"
setw -g pane-border-lines single

# ── Miscellaneous options ──────────────────────────────────────
# Enable activity monitoring
set -g monitor-activity on
set -g visual-activity off

# Enable bell monitoring
set -g visual-bell on

# Faster pane switching
bind -r C-h select-pane -L
bind -r C-j select-pane -D
bind -r C-k select-pane -U
bind -r C-l select-pane -R

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'